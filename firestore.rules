rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public profile: the chosen name. Readable by every signed-in player (scoreboards).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_-]{3,20}$')
        && request.resource.data.nameKey == request.resource.data.name.lower()
        // The name must be claimed by this player in the same write (or earlier).
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.nameKey)).data.uid == uid;
      allow delete: if false;

      // Synced localStorage values: private to the owner.
      match /progress/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // Name registry: one document per lower-case name, claimed once. A player holds exactly the
    // name in their profile: claiming and releasing happen in the same write as the profile change.
    function profileAfter() { return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    match /names/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && key.matches('^[a-z0-9_-]{3,20}$')
        && profileAfter().nameKey == key;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && profileAfter().nameKey != key;
      allow update: if false;
    }
  }
}
